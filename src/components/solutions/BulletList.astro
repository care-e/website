---
interface Props {
  /** Each item may start with a bold lead-in, e.g. { lead: 'Heavy workload', text: '– that…' }. */
  items: (string | { lead: string; text?: string })[];
  columns?: 1 | 2;
  class?: string;
}

const { items, columns = 1, class: className } = Astro.props;
---

<ul
  class:list={[
    'list-disc space-y-1 pl-9 text-lead font-medium',
    columns === 2 && 'md:columns-2 md:gap-x-16 [&>li]:break-inside-avoid',
    className,
  ]}
>
  {items.map((item) =>
    typeof item === 'string' ? (
      <li>{item}</li>
    ) : (
      <li>
        <strong class="font-semibold">{item.lead}</strong>
        {item.text && ` ${item.text}`}
      </li>
    ),
  )}
</ul>
