---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  imageAlt: string;
  /** Rendered width in px at the 1920 design size. */
  imageWidth?: number;
  /** Put the image on the left. */
  reverse?: boolean;
  class?: string;
}

const { image, imageAlt, imageWidth = 560, reverse = false, class: className } = Astro.props;
---

<div class:list={['grid items-center gap-8 lg:grid-cols-2 lg:gap-[1.25rem]', className]}>
  <div class:list={[reverse && 'lg:order-2']}>
    <slot />
  </div>
  <Image
    src={image}
    alt={imageAlt}
    width={Math.min(imageWidth, image.width)}
    densities={image.width >= imageWidth * 2 ? [1, 2] : undefined}
    class:list={['mx-auto h-auto w-full', reverse && 'lg:order-1']}
    style={`max-width: ${imageWidth / 16}rem`}
  />
</div>
