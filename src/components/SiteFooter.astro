---
import LogoWhite from '../assets/logos/care-e-logo-white.svg';
import XIcon from '../assets/icons/x.svg';
import LinkedInIcon from '../assets/icons/linkedin.svg';
import { CONTACT_EMAILS, FOOTER_NAV, SOCIAL_LINKS } from '../consts';

const socials = [
  { label: 'CARE-E Ai on X', href: SOCIAL_LINKS.x, Icon: XIcon },
  { label: 'CARE-E Ai on LinkedIn', href: SOCIAL_LINKS.linkedin, Icon: LinkedInIcon },
];
---

<footer class="bg-brand text-white">
  <div class="container-page grid gap-10 py-14 sm:grid-cols-2 lg:grid-cols-[1.45fr_1fr_0.85fr_0.6fr] lg:gap-8 lg:py-[3.75rem]">
    <div>
      <a href="/" aria-label="CARE-E home" class="inline-block">
        <LogoWhite class="h-16 w-auto lg:h-[6rem]" />
      </a>
      <p class="mt-6 text-footer-link">Email Address</p>
      <ul class="mt-3 space-y-1">
        {CONTACT_EMAILS.map((email) => (
          <li>
            <a href={`mailto:${email}`} class="text-footer-link underline hover:no-underline">
              {email}
            </a>
          </li>
        ))}
      </ul>
    </div>

    {FOOTER_NAV.map((group, i) => (
      <nav aria-label={group.heading}>
        <h2 class="text-footer-heading font-semibold">{group.heading}</h2>
        <ul class="mt-6 space-y-4 lg:space-y-[1.625rem]">
          {group.links.map((link) => (
            <li>
              <a href={link.href} class="text-footer-link hover:underline">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
        {i === FOOTER_NAV.length - 1 && (
          <ul class="mt-6 flex items-center gap-4" aria-label="Social media">
            {socials.map(({ label, href, Icon }) => (
              <li>
                <a
                  href={href}
                  aria-label={label}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="block hover:opacity-80"
                >
                  <Icon class="h-[1.875rem] w-auto" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        )}
      </nav>
    ))}
  </div>
</footer>
