---
import Logo from '../assets/logos/care-e-logo.svg';
import Chevron from '../assets/icons/chevron.svg';
import navBg from '../assets/home/nav-bg.png';
import Button from './Button.astro';
import { MAIN_NAV, ROUTES } from '../consts';

const path = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === ROUTES.home ? path === ROUTES.home : path.startsWith(href.split('#')[0]);
---

<header class="sticky top-0 z-50">
  <div class="relative rounded-b-[1.875rem] border-2 border-t-0 border-brand-green bg-white/50 backdrop-blur-[0.375rem]">
    <img
      src={navBg.src}
      alt=""
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 size-full rounded-b-[1.875rem] object-cover"
    />
    <nav
      class="relative mx-auto flex h-20 w-[min(100%-2rem,108.25rem)] items-center justify-between gap-6 lg:h-[7.6875rem]"
      aria-label="Main"
    >
      <a href={ROUTES.home} class="shrink-0" aria-label="CARE-E Ai home">
        <Logo class="h-11 w-auto lg:h-[3.75rem]" />
      </a>

      <ul class="hidden items-center gap-[3.75rem] xl:flex">
        {MAIN_NAV.map((item) => (
          <li class="group relative">
            <a
              href={item.href}
              class:list={[
                'flex items-center gap-[0.9375rem] py-4 text-nav font-medium whitespace-nowrap hover:text-brand',
                isCurrent(item.href) ? 'text-brand' : 'text-ink',
              ]}
              aria-current={isCurrent(item.href) ? 'page' : undefined}
              aria-haspopup={item.children ? 'true' : undefined}
            >
              {item.label}
              {item.children && (
                <Chevron
                  class="h-[0.8125rem] w-[0.4375rem] -rotate-90 transition-transform group-focus-within:rotate-90 group-hover:rotate-90"
                  aria-hidden="true"
                />
              )}
            </a>
            {item.children && (
              <ul class="invisible absolute top-full left-0 min-w-[18rem] translate-y-1 rounded-[0.625rem] border border-brand-green/40 bg-white p-2 opacity-0 shadow-lg transition group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100">
                {item.children.map((child) => (
                  <li>
                    <a
                      href={child.href}
                      class="block rounded-[0.375rem] px-4 py-2.5 text-[1.125rem] font-medium whitespace-nowrap hover:bg-brand-tint hover:text-brand"
                    >
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
      </ul>

      <div class="hidden items-center gap-5 xl:flex">
        <Button href="#" variant="outline" class="h-[3.75rem] min-w-[8.3125rem]">
          Login
        </Button>
        <Button href={ROUTES.contact} class="h-[3.75rem] min-w-[11.875rem]">
          Contact Us
        </Button>
      </div>

      <button
        type="button"
        class="flex size-11 items-center justify-center rounded-[0.625rem] border-2 border-brand text-brand xl:hidden"
        aria-controls="mobile-menu"
        aria-expanded="false"
        data-menu-toggle
      >
        <span class="sr-only">Open menu</span>
        <svg width="22" height="16" viewBox="0 0 22 16" fill="none" aria-hidden="true">
          <path
            d="M1 1h20M1 8h20M1 15h20"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
          ></path>
        </svg>
      </button>
    </nav>

    <div
      id="mobile-menu"
      class="relative hidden max-h-[calc(100dvh-5rem)] overflow-y-auto border-t border-brand-green/40 xl:hidden"
    >
      <ul class="mx-auto flex w-[min(100%-2rem,108.25rem)] flex-col py-4">
        {MAIN_NAV.map((item) => (
          <li>
            <a
              href={item.href}
              class="block py-3 text-lg font-semibold hover:text-brand"
              aria-current={isCurrent(item.href) ? 'page' : undefined}
            >
              {item.label}
            </a>
            {item.children && (
              <ul class="mb-2 border-l-2 border-brand-tint pl-4">
                {item.children.map((child) => (
                  <li>
                    <a href={child.href} class="block py-2 text-base hover:text-brand">
                      {child.label}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </li>
        ))}
        <li class="mt-3 flex gap-3">
          <Button href="#" variant="outline" class="flex-1">
            Login
          </Button>
          <Button href={ROUTES.contact} class="flex-1">
            Contact Us
          </Button>
        </li>
      </ul>
    </div>
  </div>
</header>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mobile-menu');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    menu?.classList.toggle('hidden', open);
  });
</script>
