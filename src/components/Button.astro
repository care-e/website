---
import type { HTMLAttributes } from 'astro/types';

type Props = (HTMLAttributes<'a'> | HTMLAttributes<'button'>) & {
  href?: string;
  variant?: 'primary' | 'outline';
};

const { href, variant = 'primary', class: className, ...rest } = Astro.props;

const classes = [
  'inline-flex items-center justify-center rounded-[0.625rem] border-2 px-5 py-2.5 text-button font-medium transition-colors focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand',
  variant === 'primary'
    ? 'border-brand bg-brand text-white hover:bg-[#006ee0] hover:border-[#006ee0]'
    : 'border-brand text-brand hover:bg-brand hover:text-white',
  className,
];
---

{href ? (
  <a href={href} class:list={classes} {...(rest as HTMLAttributes<'a'>)}>
    <slot />
  </a>
) : (
  <button class:list={classes} {...(rest as HTMLAttributes<'button'>)}>
    <slot />
  </button>
)}
