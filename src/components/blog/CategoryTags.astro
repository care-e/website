---
import { categoryHref } from '../../lib/blog';

interface Props {
  categories: string[];
  /** Highlights the current category on a category page. */
  current?: string;
  label?: string;
  class?: string;
}

const { categories, current, label = 'Categories', class: className } = Astro.props;
---

<ul class:list={['flex flex-wrap gap-2', className]} aria-label={label}>
  {categories.map((c) => (
    <li>
      <a
        href={categoryHref(c)}
        aria-current={c === current ? 'page' : undefined}
        class:list={[
          'relative z-10 block rounded-full border border-brand px-3.5 py-1.5 text-[0.9375rem] leading-tight font-medium transition-colors',
          c === current
            ? 'bg-brand text-white'
            : 'bg-white text-brand hover:bg-brand hover:text-white',
        ]}
      >
        {c}
      </a>
    </li>
  ))}
</ul>
