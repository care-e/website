---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

type Props = { post: CollectionEntry<'blog'> };

const { post } = Astro.props;
const href = `/blog/${post.id}/`;
---

<li class="border-brand-gradient flex flex-col overflow-hidden rounded-[0.625rem]">
  {post.data.heroImage && (
    <a href={href} tabindex="-1" aria-hidden="true">
      <Image
        src={post.data.heroImage}
        alt=""
        width={520}
        densities={[1, 2]}
        class="aspect-[16/9] w-full object-cover"
      />
    </a>
  )}
  <div class="flex flex-1 flex-col p-6 lg:p-[1.875rem]">
    <time datetime={post.data.pubDate.toISOString()} class="text-base font-semibold text-ink-muted">
      {post.data.pubDate.toLocaleDateString('en-US', { dateStyle: 'long', timeZone: 'UTC' })}
    </time>
    <h2 class="mt-2 text-[1.5625rem] leading-[1.3] font-bold text-brand">
      <a href={href} class="hover:underline">
        {post.data.title}
      </a>
    </h2>
    <p class="mt-3 line-clamp-4 flex-1 text-[1.125rem] leading-[1.6] font-medium">
      {post.data.description}
    </p>
    <a href={href} class="mt-4 font-semibold text-brand underline hover:no-underline">
      Read more<span class="sr-only">: {post.data.title}</span>
    </a>
  </div>
</li>
