---
import { Image } from 'astro:assets';
import contactImage from '../assets/home/contact.png';
import type { HTMLAttributes } from 'astro/types';
import Button from './Button.astro';

interface Props {
  /** Heading level, so the section works as a page's h1 or as a lower section. */
  headingLevel?: 'h1' | 'h2';
}

const { headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;

const topics = ['Requesting Demo', 'Becoming a Partner', 'General Information'];

interface Field {
  name: string;
  label: string;
  placeholder?: string;
  type?: 'text' | 'email' | 'tel';
  autocomplete?: HTMLAttributes<'input'>['autocomplete'];
  required?: boolean;
  multiline?: boolean;
}

const fields: Field[] = [
  {
    name: 'first_name',
    label: 'First Name',
    placeholder: 'Enter First Name',
    autocomplete: 'given-name',
    required: true,
  },
  {
    name: 'last_name',
    label: 'Last Name',
    placeholder: 'Enter Last Name',
    autocomplete: 'family-name',
    required: true,
  },
  {
    name: 'email',
    label: 'Email Address',
    placeholder: 'Enter Email',
    type: 'email',
    autocomplete: 'email',
    required: true,
  },
  {
    name: 'organization',
    label: 'Organization or Specialty Type',
    placeholder: 'Enter Type',
    autocomplete: 'organization',
    required: true,
  },
  {
    name: 'phone',
    label: 'Phone Number',
    placeholder: 'Enter Number',
    type: 'tel',
    autocomplete: 'tel',
    required: true,
  },
  { name: 'note', label: 'Note/Comment', multiline: true },
];
---

<section
  id="contact"
  class="scroll-mt-16 bg-white py-14 lg:scroll-mt-24 lg:pt-[3.25rem] lg:pb-[9.375rem]"
>
  <div class="container-page">
    <Heading class="text-center text-display leading-normal font-bold text-brand">
      Contact Us
    </Heading>
    <p class="mt-6 font-mulish text-lead font-semibold lg:mt-[2.0625rem]">
      We’re here to help! Select your area of interest, provide your details, and we’ll get back to
      you as soon as possible. We look forward to connecting with you.
    </p>

    <form class="mt-8 lg:mt-[2.1875rem]" method="post" action="#">
      <fieldset>
        <legend class="text-title font-bold text-brand">I’m Interested in ....</legend>
        <div class="mt-4 flex max-w-[85.125rem] flex-wrap gap-x-4 gap-y-4 lg:gap-x-[4.6875rem] lg:gap-y-9">
          {topics.map((topic, i) => (
            <label class="cursor-pointer">
              <input
                type="radio"
                name="topic"
                value={topic}
                checked={i === 0}
                class="peer sr-only"
              />
              <span class="block rounded-[3.1875rem] border border-black/30 px-5 py-2.5 font-mulish text-lead leading-[1.236] font-semibold whitespace-nowrap transition-colors peer-checked:border-brand peer-checked:bg-brand peer-checked:text-white peer-focus-visible:outline-2 peer-focus-visible:outline-offset-2 peer-focus-visible:outline-brand hover:border-brand lg:px-[1.875rem] lg:py-[0.8125rem]">
                {topic}
              </span>
            </label>
          ))}
        </div>
      </fieldset>

      <div class="mt-8 grid items-end gap-10 lg:mt-[3.0625rem] lg:grid-cols-[minmax(0,59.25rem)_minmax(0,1fr)] lg:gap-[5.5rem]">
        <div class="space-y-[1.375rem]">
          {fields.map((field) => (
            <div>
              <label
                for={`contact-${field.name}`}
                class="block pl-2 text-button leading-[1.236] font-medium"
              >
                {field.label}
                {field.required && (
                  <span class="text-brand" aria-hidden="true">
                    {' '}
                    *
                  </span>
                )}
              </label>
              {field.multiline ? (
                <textarea
                  id={`contact-${field.name}`}
                  name={field.name}
                  rows="3"
                  class="mt-2.5 block min-h-[3.75rem] w-full resize-y rounded-[0.625rem] bg-field px-5 py-4 text-button leading-[1.236] font-normal outline-brand"
                />
              ) : (
                <input
                  id={`contact-${field.name}`}
                  name={field.name}
                  type={field.type ?? 'text'}
                  placeholder={field.placeholder}
                  autocomplete={field.autocomplete}
                  required={field.required}
                  class="mt-2.5 block h-[3.75rem] w-full rounded-[0.625rem] bg-field px-5 text-button font-normal outline-brand"
                />
              )}
            </div>
          ))}
          <Button type="submit" class="h-[3.75rem]">
            Submit
          </Button>
        </div>
        <Image
          src={contactImage}
          alt="Support agent with a headset handling calls, chats and email"
          class="mx-auto h-auto w-full max-w-[40.75rem]"
        />
      </div>
    </form>
  </div>
</section>
