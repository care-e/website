<script>
  // Opens the bio <dialog> named by a trigger's data-bio attribute; clicking the backdrop closes it.
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const trigger = target.closest<HTMLElement>('[data-bio]');
    if (trigger) {
      document.querySelector<HTMLDialogElement>(`#bio-${trigger.dataset.bio}`)?.showModal();
    } else if (target instanceof HTMLDialogElement) {
      target.close();
    }
  });
</script>
