---
import shield from '../../assets/home/built-for-healthcare.svg?url';

const items = [
  {
    title: 'Safe, Secure, Compliant',
    body: 'CARE-E prioritizes the protection of sensitive patient data with a robust security framework that exceeds industry standards. Our EHR-integrated clinical assistant ensures seamless, secure, and compliant workflows, giving healthcare organizations peace of mind.',
  },
  {
    title: 'HIPAA Compliance',
    body: 'CARE-E strictly adheres to HIPAA regulations, implementing comprehensive physical, network, and process safeguards to secure protected health information (PHI).',
  },
];
---

<section class="container-page grid items-center gap-10 pt-14 pb-20 lg:grid-cols-[minmax(0,1fr)_minmax(0,22rem)] lg:gap-20 lg:pt-[4.6875rem] lg:pb-[9.375rem]">
  <div>
    <h2 class="text-display font-semibold">
      Enterprise-Grade Security <span class="text-brand">Built for Healthcare</span>
    </h2>
    <dl class="mt-4 space-y-3 text-lead leading-[1.69] font-medium lg:mt-5">
      {items.map((item) => (
        <div>
          <dt class="font-semibold">{item.title}</dt>
          <dd>{item.body}</dd>
        </div>
      ))}
    </dl>
  </div>
  <img
    src={shield}
    alt=""
    width="339"
    height="398"
    loading="lazy"
    decoding="async"
    class="mx-auto h-auto w-full max-w-[16rem] lg:max-w-[22rem]"
  />
</section>
