---
import { Image } from 'astro:assets';
import whoIsImage from '../../assets/home/who-is.png';
import Typewriter from '../Typewriter.astro';

const phrases = [
  'captures your clinical notes.',
  'writes your patient care plans.',
  'automates repetitive tasks.',
  'streamlines your documentation.',
  'optimizes your workflow.',
  'handles your administrative tasks.',
  'reduces your charting time.',
  'supports your decision-making.',
  'improves your efficiency.',
  'is your AI-clinical assistant.',
];
---

<section class="grid items-center gap-10 py-14 lg:grid-cols-[minmax(0,50rem)_minmax(0,1fr)] lg:gap-0 lg:py-[3.75rem]">
  <Image
    src={whoIsImage}
    width={814}
    densities={[1, 2]}
    alt="Laptop showing the CARE-E robot saying hello"
    class="mx-auto h-auto w-full max-w-[50.875rem] max-lg:w-[min(100%-2rem,50.875rem)] lg:-ml-10"
  />
  <div class="container-page lg:mr-[8.75rem] lg:ml-0 lg:w-auto lg:max-w-[64.3125rem]">
    <h2 class="text-display font-semibold">
      Who is <span class="text-brand">CARE-E</span>
    </h2>
    <p class="mt-4 text-lead font-medium lg:mt-5">
      CARE-E listens to patient encounters, captures structured notes, generates documentation,
      manages orders, and suggests treatment plans while maintaining accurate and consistent patient
      records. Beyond documentation, CARE-E streamlines repetitive tasks, while providing clinical
      decision support (CDS), real-time insights, and analytics to assist clinicians in making
      informed decisions at the point of care. Clinicians review and approve all information before
      it’s updated in the EHR, ensuring accuracy and reliability.
    </p>
    <p class="mt-4 text-lead font-medium">
      By integrating seamlessly with existing EHRs–CARE-E joins you throughout your workday, as a
      smart layer to your system.
    </p>
    <div class="mt-6 min-h-[2.6em] lg:mt-8">
      <Typewriter prefix="CARE-E" phrases={phrases} />
    </div>
  </div>
</section>
