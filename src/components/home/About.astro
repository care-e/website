---
import { Image } from 'astro:assets';
import aboutImage from '../../assets/home/about.png';
import Button from '../Button.astro';
import { ROUTES } from '../../consts';
---

<section
  id="mission"
  class="container-page grid items-center gap-10 py-14 lg:grid-cols-[minmax(0,50.5625rem)_minmax(0,1fr)] lg:gap-[5.1875rem] lg:py-[5.125rem]"
>
  <div>
    <h2 class="text-display font-semibold">
      Our Mission at <span class="text-brand">CARE-E Ai</span>
    </h2>
    <p class="mt-8 text-lead font-medium lg:mt-[2.625rem]">
      Our mission is to reduce clinician burnout and improve patient care through advanced AI
      solutions. By streamlining clinical workflows and automating administrative tasks, we empower
      healthcare providers to focus on what truly matters—delivering exceptional patient care.
    </p>
    <div class="mt-8 flex flex-wrap gap-4 lg:mt-[2.375rem]">
      <Button href={ROUTES.about} variant="outline" class="h-[3.75rem]">
        Learn More
      </Button>
      <Button href={ROUTES.contact} class="h-[3.75rem]">
        Get Demo
      </Button>
    </div>
  </div>
  <Image
    src={aboutImage}
    width={710}
    densities={[1, 2]}
    alt="A doctor with a clipboard working alongside the CARE-E robot assistant"
    class="mx-auto h-auto w-full max-w-[44.375rem]"
  />
</section>
