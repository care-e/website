---
import { Image } from 'astro:assets';
import { FEATURED_SPECIALTIES } from '../../data/specialties';
import { ROUTES } from '../../consts';
---

<section class="bg-wash py-14 lg:py-[6rem]">
  <div class="container-page">
    <p class="text-button font-semibold tracking-wide text-brand-green uppercase">Who it’s for</p>
    <h2 class="mt-3 max-w-[56rem] text-display font-semibold">
      Built for <span class="text-brand">independent specialty practices.</span>
    </h2>
    <p class="mt-4 max-w-[52rem] text-lead font-medium text-ink-soft/80">
      From solo physicians to growing groups, CARE-E fits the way your specialty documents.
    </p>
    <ul class="mt-10 grid grid-cols-2 gap-3 sm:grid-cols-3 lg:mt-12 lg:grid-cols-6 lg:gap-4">
      {FEATURED_SPECIALTIES.map((s) => (
        <li class="flex items-center gap-3 rounded-[0.75rem] bg-white px-4 py-3 shadow-sm">
          <Image src={s.icon} alt="" width={36} height={36} densities={[1, 2]} class="size-9" />
          <span class="text-button leading-[1.236] font-semibold">{s.label}</span>
        </li>
      ))}
    </ul>
    <p class="mt-8 text-button font-medium">
      Running a larger organization?{' '}
      <a
        href={ROUTES.whoWeWorkWith}
        class="font-semibold text-brand underline-offset-4 hover:underline"
      >
        See who we work with →
      </a>
    </p>
  </div>
</section>
