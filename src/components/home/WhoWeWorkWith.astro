---
import OrgCard from '../OrgCard.astro';
import { ORGANIZATIONS } from '../../data/organizations';
---

<section class="container-page py-14 lg:py-[5.625rem]">
  <h2 class="text-display font-semibold">
    "Who <span class="text-brand">We Work With</span>"
  </h2>
  <h3 class="mt-6 text-title font-bold text-brand lg:mt-[1.875rem]">Healthcare Organizations</h3>
  <ul class="mt-4 flex flex-wrap justify-center gap-5 *:w-full sm:*:w-[calc(50%-0.625rem)] lg:*:w-[calc(25%-0.9375rem)]">
    {ORGANIZATIONS.map((org) => (
      <OrgCard {...org} />
    ))}
  </ul>
</section>
