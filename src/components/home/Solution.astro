---
import { Image } from 'astro:assets';
import Button from '../Button.astro';
import { SOLUTION_TABS } from '../../data/solutions';
---

<section class="container-page py-14 lg:py-[4.6875rem]">
  <h2 class="text-display font-semibold">
    The <span class="text-brand">CARE-E Solution</span>
  </h2>

  <div data-tabs class="mt-8 lg:mt-[3.125rem]">
    <div
      role="tablist"
      aria-label="CARE-E solutions"
      class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-5 lg:gap-[0.5625rem]"
    >
      {SOLUTION_TABS.map((tab, i) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-controls={`panel-${tab.id}`}
          aria-selected={i === 0 ? 'true' : 'false'}
          tabindex={i === 0 ? 0 : -1}
          class="border-brand-gradient flex min-h-20 cursor-pointer items-center justify-center rounded-[0.625rem] px-3 py-3 text-center text-tab font-semibold text-brand transition-colors hover:bg-brand-tint aria-selected:border-brand-green aria-selected:bg-brand aria-selected:bg-none aria-selected:text-white lg:min-h-[7.125rem]"
        >
          {tab.label}
        </button>
      ))}
    </div>

    {SOLUTION_TABS.map((tab, i) => (
      <div
        role="tabpanel"
        id={`panel-${tab.id}`}
        aria-labelledby={`tab-${tab.id}`}
        hidden={i !== 0}
        tabindex="0"
        class="mt-8 lg:mt-[3.125rem]"
      >
        <p class="text-lead font-medium">{tab.intro}</p>
        <ul class="mt-8 grid gap-x-[4rem] gap-y-7 md:grid-cols-2 lg:mt-[3.125rem]">
          {tab.items.map((item) => (
            <li class="flex items-start gap-5">
              <Image
                src={item.icon}
                alt=""
                width={80}
                class="mt-1 size-[2.5rem] shrink-0 object-contain"
              />
              <p class="text-lead font-medium">
                <strong class="font-semibold">{item.title}</strong> – {item.text}
              </p>
            </li>
          ))}
        </ul>
        <Button href={tab.href} variant="outline" class="mt-8 h-[3.75rem] lg:mt-[3.125rem]">
          Learn More
        </Button>
      </div>
    ))}
  </div>
</section>

<script>
  // Accessible tabs: click or arrow keys to switch panels.
  for (const root of document.querySelectorAll<HTMLElement>('[data-tabs]')) {
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
    const select = (tab: HTMLButtonElement) => {
      for (const t of tabs) {
        const active = t === tab;
        t.setAttribute('aria-selected', String(active));
        t.tabIndex = active ? 0 : -1;
        const panel = document.getElementById(t.getAttribute('aria-controls') ?? '');
        if (panel) panel.hidden = !active;
      }
    };
    root.addEventListener('click', (e) => {
      const tab = (e.target as HTMLElement).closest<HTMLButtonElement>('[role="tab"]');
      if (tab) select(tab);
    });
    root.addEventListener('keydown', (e) => {
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      const next =
        e.key === 'ArrowRight'
          ? (i + 1) % tabs.length
          : e.key === 'ArrowLeft'
            ? (i - 1 + tabs.length) % tabs.length
            : e.key === 'Home'
              ? 0
              : e.key === 'End'
                ? tabs.length - 1
                : -1;
      if (next < 0) return;
      e.preventDefault();
      tabs[next].focus();
      select(tabs[next]);
    });
  }
</script>
