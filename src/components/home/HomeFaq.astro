---
import { ROUTES } from '../../consts';

// Short homepage answers; the full list lives on /faq/.
const faqs = [
  {
    q: 'Do I need to change EHRs?',
    a: 'No. CARE-E connects to any certified EHR, so you keep the system you use today.',
  },
  {
    q: 'Does CARE-E sign or submit anything on its own?',
    a: 'No. Every note, order and code suggestion waits for your review and signature.',
  },
  {
    q: 'Is patient data secure?',
    a: 'CARE-E is HIPAA-compliant, and we sign a Business Associate Agreement with every practice.',
  },
  {
    q: 'How much does it cost?',
    a: 'Pricing depends on the size of your practice and what you need. Contact us for pricing.',
  },
  {
    q: 'How do I get started?',
    a: 'Book a demo. We’ll walk through your specialty, workflow and EHR, then get you set up.',
  },
];
---

<section class="bg-white py-14 lg:py-[6rem]">
  <div class="container-page grid gap-10 lg:grid-cols-[minmax(0,26rem)_minmax(0,1fr)] lg:gap-20">
    <div>
      <h2 class="text-display font-semibold">
        Questions, <span class="text-brand">answered.</span>
      </h2>
      <a
        href={ROUTES.faq}
        class="mt-4 inline-block text-button font-semibold text-brand underline-offset-4 hover:underline"
      >
        All FAQs →
      </a>
    </div>
    <div class="space-y-4">
      {faqs.map((f) => (
        <details class="group border-brand-gradient rounded-[0.625rem] open:shadow-md">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 text-tab leading-[1.3] font-semibold marker:hidden [&::-webkit-details-marker]:hidden">
            <h3>{f.q}</h3>
            <span
              class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-tint text-2xl leading-none text-brand transition-transform group-open:rotate-45"
              aria-hidden="true"
            >
              +
            </span>
          </summary>
          <p class="px-6 pb-6 text-lead font-medium">{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>
