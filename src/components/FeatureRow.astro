---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  title: string;
  image: ImageMetadata;
  imageAlt: string;
  /** Screenshots fill the column; illustrations keep their design size. */
  imageKind?: 'screenshot' | 'illustration';
  /** Display width in px for illustrations (the source files are 2x). */
  imageWidth?: number;
  reverse?: boolean;
}

const {
  title,
  image,
  imageAlt,
  imageKind = 'screenshot',
  imageWidth = 810,
  reverse = false,
} = Astro.props;
---

<article class="grid items-center gap-8 lg:grid-cols-2 lg:gap-5">
  <div class:list={['lg:self-start', reverse && 'lg:order-2 lg:pl-0']}>
    <h3 class="text-title font-bold text-brand">{title}</h3>
    <div class="mt-3 text-lead leading-[1.69] font-medium lg:mt-4">
      <slot />
    </div>
  </div>
  <Image
    src={image}
    alt={imageAlt}
    width={imageWidth}
    densities={[1, 2]}
    class:list={[
      'h-auto',
      imageKind === 'screenshot' ? 'w-full rounded-[0.625rem]' : 'mx-auto w-full max-w-[var(--w)]',
      reverse && 'lg:order-1',
    ]}
    style={imageKind === 'illustration' ? `--w: ${imageWidth / 16}rem` : undefined}
  />
</article>
