---
// A few audit-log lines as texture. Plain-language actions only: no columns, filters or schema.
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

// Follows the real log of a test visit (consent → assistant → vitals saved → approved → summary sent).
const rows = [
  { time: '9:02 AM', action: 'Visit started: patient consented to recording (verbal)' },
  { time: '9:06 AM', action: 'Asked the assistant a question' },
  { time: '9:08 AM', action: 'Saved vitals: blood pressure, SpO₂, heart rate' },
  { time: '9:10 AM', action: 'Clinician approved the visit' },
  { time: '9:10 AM', action: 'Emailed the visit summary to the patient' },
];
---

<figure
  class:list={[
    'rounded-[1.25rem] bg-white p-6 shadow-[0_1.5rem_4rem_-1rem_rgb(9_128_254/0.25)] lg:p-8',
    className,
  ]}
>
  <ol class="divide-y divide-black/10">
    {rows.map((row, i) => (
      <li class:list={['flex items-baseline gap-4 py-3 text-button font-medium', i === rows.length - 1 && 'blur-[2px]']}>
        <span class="shrink-0 whitespace-nowrap text-ink-muted tabular-nums">{row.time}</span>
        <span class="flex-1">{row.action}</span>
        <span class="rounded-full bg-brand-green/15 px-2 text-sm font-semibold text-brand-green">OK</span>
      </li>
    ))}
  </ol>
  <figcaption class="mt-3 text-sm font-medium text-ink-muted">
    Every action, by whom and for which patient. Exportable for your compliance team.
  </figcaption>
</figure>
