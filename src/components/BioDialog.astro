---
import { Image } from 'astro:assets';
import { initials, type Person } from '../data/people';

type Props = Person;

const { id, name, role, photo, linkedin, bio } = Astro.props;
---

<dialog
  id={`bio-${id}`}
  aria-labelledby={`bio-${id}-name`}
  class="m-auto w-[min(100%-2rem,50rem)] rounded-[1.25rem] border-2 border-brand-green bg-white p-0 text-ink backdrop:bg-black/50"
>
  <div class="flex max-h-[85dvh] flex-col">
    <div class="flex items-center gap-5 border-b border-black/10 p-6 lg:p-8">
      {photo ? (
        <Image
          src={photo}
          alt=""
          width={96}
          height={96}
          densities={[1, 2]}
          class="size-20 shrink-0 rounded-full object-cover lg:size-24"
        />
      ) : (
        <span class="flex size-20 shrink-0 items-center justify-center rounded-full bg-brand-tint text-2xl font-bold text-brand lg:size-24">
          {initials(name)}
        </span>
      )}
      <div class="min-w-0 flex-1">
        <h2 id={`bio-${id}-name`} class="text-[1.5rem] leading-tight font-bold text-brand">
          {name}
        </h2>
        <p class="mt-1 text-[1.125rem] font-medium">{role}</p>
        {linkedin && (
          <a
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-2 inline-block text-base font-semibold text-brand underline hover:no-underline"
          >
            LinkedIn profile
          </a>
        )}
      </div>
      <form method="dialog" class="self-start">
        <button
          class="flex size-10 cursor-pointer items-center justify-center rounded-full text-2xl leading-none hover:bg-brand-tint"
          aria-label="Close"
        >
          ×
        </button>
      </form>
    </div>
    <div class="space-y-4 overflow-y-auto p-6 text-[1.125rem] leading-[1.6] font-medium lg:p-8">
      {bio.map((p) => (
        <p>{p}</p>
      ))}
    </div>
  </div>
</dialog>
