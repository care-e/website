---
interface Props {
  prefix: string;
  phrases: string[];
}

const { prefix, phrases } = Astro.props;
---

<!-- Recreates the previous site's animated "CARE-E …" GIF as live text. -->
<p class="text-title leading-[1.3] font-bold" data-typewriter={JSON.stringify(phrases)}>
  <span class="text-brand">{prefix}</span>{' '}
  <span class="font-medium italic" aria-hidden="true" data-typewriter-text>
    {phrases[0]}
  </span>
  <span
    class="ml-0.5 inline-block w-[0.08em] animate-pulse bg-current align-[-0.1em] motion-reduce:hidden"
    style="height: 1em"
    aria-hidden="true"
  ></span>
  <span class="sr-only">{phrases.join(' ')}</span>
</p>

<script>
  for (const el of document.querySelectorAll<HTMLElement>('[data-typewriter]')) {
    const target = el.querySelector<HTMLElement>('[data-typewriter-text]');
    if (!target || matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    const phrases: string[] = JSON.parse(el.dataset.typewriter ?? '[]');
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    (async () => {
      for (let i = 0; ; i = (i + 1) % phrases.length) {
        const text = phrases[i];
        for (let n = 0; n <= text.length; n++) {
          target.textContent = text.slice(0, n);
          await wait(55);
        }
        await wait(1600);
        for (let n = text.length; n >= 0; n--) {
          target.textContent = text.slice(0, n);
          await wait(25);
        }
        await wait(300);
      }
    })();
  }
</script>
