---
import { Image } from 'astro:assets';
import LinkedInIcon from '../../assets/icons/linkedin-blue.svg';
import type { Person } from '../../data/people';

type Props = Person;

const { id, name, role, photo, linkedin } = Astro.props;
---

<li class="flex w-full max-w-[21.8125rem] flex-col items-center rounded-t-[11.875rem] rounded-b-[0.625rem] border-2 border-brand-green bg-white px-[0.875rem] pt-[0.875rem] pb-7 text-center">
  {photo && (
    <Image
      src={photo}
      alt={`Portrait of ${name}`}
      width={320}
      height={320}
      densities={[1, 2]}
      class="aspect-square w-full max-w-[20rem] rounded-full object-cover"
    />
  )}
  <h3 class="mt-4 text-[1.5rem] leading-tight font-bold text-brand">{name}</h3>
  <p class="mt-2 text-button leading-normal font-medium">{role}</p>
  <div class="mt-3 flex items-center gap-4">
    {linkedin && (
      <a
        href={linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${name} on LinkedIn`}
        class="hover:opacity-80"
      >
        <LinkedInIcon class="size-[1.6875rem]" aria-hidden="true" />
      </a>
    )}
    <button
      type="button"
      data-bio={id}
      class="cursor-pointer text-[1rem] font-semibold text-brand underline hover:no-underline"
    >
      View bio
    </button>
  </div>
</li>
