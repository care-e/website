---
import SolutionLayout from '../layouts/SolutionLayout.astro';
import SectionTitle from '../components/solutions/SectionTitle.astro';
import SubTitle from '../components/solutions/SubTitle.astro';
import MediaSplit from '../components/solutions/MediaSplit.astro';
import IconCards from '../components/solutions/IconCards.astro';
import BulletList from '../components/solutions/BulletList.astro';
import { solutionIcon } from '../data/solution-nav';
import whyImage from '../assets/solutions/art/cds-why.png';

// Copy from the previous care-e.ai CDS page.
const supports = [
  {
    title: 'Real-time alerts & notifications',
    icon: solutionIcon('bell-1.svg'),
    text: 'Stay informed about potential adverse events and drug interactions.',
  },
  {
    title: 'Evidence-based recommendations',
    icon: solutionIcon('evidance-1.svg'),
    text: 'Access clinical and standard of care guidelines tailored to each patient’s specific needs.',
  },
  {
    title: 'Comprehensive patient overviews',
    icon: solutionIcon('comprehensive-1.svg'),
    text: 'Integrate data from multiple systems for a complete view of patient health.',
  },
  {
    title: 'Regulatory Compliance Support',
    icon: solutionIcon('regulatory-1.svg'),
    text: 'Receive timely, data-driven guidance for diagnosis, treatment, and follow-up care.',
  },
];

const safety = [
  {
    title: 'Leverage Tailored Decision Support',
    icon: solutionIcon('decision-support-2.svg'),
    text: 'By seamlessly integrating proprietary or third-party validated decision support tools into clinical workflows to enhance precision and efficiency.',
  },
  {
    title: 'Improve diagnostic accuracy',
    icon: solutionIcon('diagnostic-2.svg'),
    text: 'With a broader, data-driven perspective on patient health.',
  },
  {
    title: 'Prevent medication errors',
    icon: solutionIcon('cross-2.svg'),
    text: 'By flagging potential drug interactions or contraindications.',
  },
];
---

<SolutionLayout
  title="Clinical Decision Support (CDS)"
  description="CARE-E delivers real-time alerts, evidence-based recommendations and complete patient overviews inside the EHR to support faster, safer clinical decisions."
>
  <section>
    <SectionTitle
      as="h1"
      lead="Unlock the Power of Clinical Decision Support (CDS)"
      highlight="with CARE-E"
    />
    <SubTitle class="mt-8">What is Clinical Decision Support?</SubTitle>
    <p class="mt-4 text-lead font-medium">
      Clinical Decision Support (CDS) is a transformative health IT component designed to enhance
      clinical decision-making during patient encounters by delivering knowledge and person-specific
      information, intelligently filtered and presented at the right time within clinical workflows.
      By seamlessly integrating into electronic health record (EHR) systems, CDS tools empower
      clinicians, staff, and patients with actionable insights to improve diagnostic accuracy,
      treatment plans, and care coordination. These tools can provide alerts for potential drug
      interactions, recommend evidence-based guidelines, assist with diagnostic coding, and identify
      gaps in care, ensuring that decisions are informed by the latest clinical evidence and
      tailored to the patient’s unique health profile.
    </p>
    <SubTitle class="mt-8">CDS encompasses a wide range of tools, including:</SubTitle>
    <BulletList
      class="mt-4"
      items={[
        {
          lead: 'Condition-specific order sets and clinical guidelines',
          text: 'to support evidence-based care.',
        },
        {
          lead: 'Concise patient data summaries and reports',
          text: 'for better decision-making.',
        },
        {
          lead: 'Diagnostic support and relevant clinical references',
          text: 'at the point of care.',
        },
        { lead: 'Automated alerts and reminders', text: 'for clinicians and patients.' },
      ]}
    />
    <p class="mt-4 text-lead font-medium">
      At CARE-E, we leverage AI and machine learning to elevate these tools, offering cutting-edge
      solutions that empower clinicians to make faster, smarter, and safer decisions.
    </p>
  </section>

  <section>
    <SectionTitle lead="How CARE-E Enhances" highlight="Clinical Decision Support" />
    <p class="mt-6 text-lead font-medium">
      CARE-E integrates seamlessly with existing EHRs, to intelligently filter and present relevant
      clinical data at the right moment. By delivering real-time insights and reducing information
      overload, CARE-E ensures that clinicians have the critical support they need to make informed
      decisions quickly and efficiently.
    </p>
    <SubTitle class="mt-8">How CARE-E Supports Smarter Clinical Decisions</SubTitle>
    <IconCards class="mt-6" items={supports} />
  </section>

  <section>
    <SectionTitle lead="Enhance Patient" highlight="Safety with CDS" />
    <p class="mt-6 text-lead font-medium">
      CDS improves patient safety and care quality by delivering precise, real-time insights. It
      helps reduce errors, prevent adverse events, and support informed clinical decisions. With
      CDS, providers can:
    </p>
    <IconCards class="mt-8" variant="center" items={safety} />
  </section>

  <section>
    <MediaSplit
      image={whyImage}
      imageAlt="AI brain hologram above a digital platform"
      imageWidth={656}
    >
      <SectionTitle lead="Why Choose" highlight="CARE-E for CDS?" />
      <SubTitle class="mt-6">
        CARE-E’s clinical decision support tools improve clinical efficiency and decision-making by:
      </SubTitle>
      <BulletList
        class="mt-4"
        items={[
          'Delivering real-time, data-driven insights to enhance patient care and reduce diagnostic errors.',
          'Providing evidence-based recommendations for more informed diagnoses, treatments, and medication management.',
          'Integrating proprietary or third-party clinically validated CDS solutions directly into workflows for customized decision support.',
          'Identifying gaps in care based on direct patient feedback to ensure more comprehensive treatment planning.',
        ]}
      />
    </MediaSplit>
    <p class="mt-6 text-lead font-medium">
      By integrating AI-driven CDS tools into clinical workflows, CARE-E helps clinicians process
      complex medical information efficiently. It combines biomedical knowledge, patient-specific
      data, and advanced inference mechanisms to support accurate, timely decision-making—leading to
      better patient outcomes and improved provider and patient satisfaction.
    </p>
  </section>
</SolutionLayout>
