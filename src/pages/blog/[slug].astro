---
import { Image } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import PostCard from '../../components/blog/PostCard.astro';
import CategoryTags from '../../components/blog/CategoryTags.astro';
import { allCategories, formatDate, getPosts, relatedPosts, type Post } from '../../lib/blog';
import { ROUTES, SITE_TITLE } from '../../consts';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, i) => ({
    params: { slug: post.id },
    props: {
      post,
      related: relatedPosts(post, posts),
      categories: allCategories(posts),
      // Posts are newest first, so "previous" is the next-older post.
      previous: posts[i + 1],
      next: posts[i - 1],
    },
  }));
}

interface Props {
  post: Post;
  related: Post[];
  categories: string[];
  previous?: Post;
  next?: Post;
}

const { post, related, categories, previous, next } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, author, heroImage, heroAlt } = post.data;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  ...(author && { author: { '@type': 'Person', name: author } }),
  publisher: { '@type': 'Organization', name: SITE_TITLE },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<BaseLayout title={title} description={description} image={heroImage?.src}>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <div class="bg-wash -mt-20 pt-20 pb-20 lg:-mt-[7.6875rem] lg:pt-[7.6875rem] lg:pb-[9.375rem]">
    <div class="container-page grid gap-12 pt-10 lg:grid-cols-[minmax(0,1fr)_20rem] lg:gap-[3.75rem] lg:pt-[5rem]">
      <div class="min-w-0">
        <article>
          <a href={ROUTES.blog} class="font-semibold text-brand hover:underline">
            ← Our Blog
          </a>
          {heroImage && (
            <Image
              src={heroImage}
              alt={heroAlt}
              width={1000}
              densities={[1, 2]}
              class="mt-6 aspect-[16/9] w-full rounded-[1.25rem] object-cover"
              loading="eager"
            />
          )}
          <h1 class="mt-8 text-[clamp(1.75rem,1.3rem+1.6vw,3rem)] leading-[1.2] font-semibold">
            {title}
          </h1>
          <p class="mt-3 text-[1.125rem] font-semibold">
            {author && <>By {author} / </>}
            <time datetime={pubDate.toISOString()}>{formatDate(pubDate)}</time>
          </p>
          <div class="prose-content mt-8">
            <Content />
          </div>
          <div class="mt-10">
            <Button href={ROUTES.contact} class="h-[3.75rem]">
              Request Demo
            </Button>
          </div>
        </article>

        <nav
          aria-label="More articles"
          class="mt-12 grid gap-4 border-t border-black/10 pt-8 sm:grid-cols-2"
        >
          {previous && (
            <a
              href={`/blog/${previous.id}/`}
              rel="prev"
              class="group rounded-[0.75rem] p-3 hover:bg-white/70"
            >
              <span class="text-[0.9375rem] font-semibold text-ink-muted">← Previous post</span>
              <span class="mt-1 block text-[1.125rem] leading-[1.35] font-bold group-hover:text-brand">
                {previous.data.title}
              </span>
            </a>
          )}
          {next && (
            <a
              href={`/blog/${next.id}/`}
              rel="next"
              class="group rounded-[0.75rem] p-3 text-right hover:bg-white/70 sm:col-start-2"
            >
              <span class="text-[0.9375rem] font-semibold text-ink-muted">Next post →</span>
              <span class="mt-1 block text-[1.125rem] leading-[1.35] font-bold group-hover:text-brand">
                {next.data.title}
              </span>
            </a>
          )}
        </nav>

        {related.length > 0 && (
          <section aria-labelledby="related-heading" class="mt-16 lg:mt-[5rem]">
            <h2 id="related-heading" class="text-title leading-[1.236] font-bold text-brand">
              Related Blogs
            </h2>
            <ul class="mt-6 grid gap-6 md:grid-cols-3 lg:mt-[2.5rem] lg:gap-[1.25rem]">
              {related.map((p) => (
                <li>
                  <PostCard post={p} maxTags={2} />
                </li>
              ))}
            </ul>
          </section>
        )}
      </div>

      <aside aria-labelledby="categories-heading" class="lg:pt-[2.75rem]">
        <div class="lg:sticky lg:top-40">
          <h2 id="categories-heading" class="text-title leading-[1.236] font-bold text-brand">
            Categories
          </h2>
          <CategoryTags
            class="mt-5 flex-col items-start lg:gap-2.5"
            categories={categories}
            label="All categories"
          />
        </div>
      </aside>
    </div>
  </div>
</BaseLayout>
