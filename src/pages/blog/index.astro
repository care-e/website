---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SectionTitle from '../../components/solutions/SectionTitle.astro';
import PostCard from '../../components/blog/PostCard.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Blog"
  description="Insights from CARE-E Ai on clinical documentation, physician burnout, patient engagement, EHR integration and AI in healthcare."
>
  <div class="bg-wash -mt-20 pt-20 pb-20 lg:-mt-[7.6875rem] lg:pt-[7.6875rem] lg:pb-[9.375rem]">
    <div class="container-page pt-10 lg:pt-[6.25rem]">
      <SectionTitle as="h1" lead="CARE-E" highlight="Blog" />
      {posts.length ? (
        <ul class="mt-10 grid gap-6 md:grid-cols-2 lg:mt-[3.125rem] lg:grid-cols-3 lg:gap-[1.25rem]">
          {posts.map((post) => (
            <PostCard post={post} />
          ))}
        </ul>
      ) : (
        <p class="mt-8 text-lead font-medium">New articles are coming soon.</p>
      )}
    </div>
  </div>
</BaseLayout>
