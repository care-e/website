---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import LogoStrip from '../components/home/LogoStrip.astro';
import About from '../components/home/About.astro';
import WhoIs from '../components/home/WhoIs.astro';
import WhoWeWorkWith from '../components/home/WhoWeWorkWith.astro';
import Solution from '../components/home/Solution.astro';
import WhyChoose from '../components/home/WhyChoose.astro';
import SetsApart from '../components/home/SetsApart.astro';
import Compliance from '../components/home/Compliance.astro';
import Testimonials from '../components/home/Testimonials.astro';
import ContactSection from '../components/ContactSection.astro';
---

<BaseLayout>
  <!-- The wash starts behind the sticky header, as in the design. -->
  <div class="bg-wash -mt-20 pt-20 lg:-mt-[7.6875rem] lg:pt-[7.6875rem]">
    <Hero />
    <LogoStrip />
    <About />
    <WhoIs />
    <WhoWeWorkWith />
    <Solution />
    <WhyChoose />
    <SetsApart />
    <Compliance />
  </div>
  <Testimonials />
  <ContactSection />
</BaseLayout>
