---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import LogoStrip from '../components/home/LogoStrip.astro';
import ProblemLine from '../components/home/ProblemLine.astro';
import HowItWorks from '../components/home/HowItWorks.astro';
import NoteContents from '../components/home/NoteContents.astro';
import AskTheChart from '../components/home/AskTheChart.astro';
import OnTheRecord from '../components/home/OnTheRecord.astro';
import InControl from '../components/home/InControl.astro';
import Specialties from '../components/home/Specialties.astro';
import Testimonials from '../components/home/Testimonials.astro';
import HomeFaq from '../components/home/HomeFaq.astro';
import ContactSection from '../components/ContactSection.astro';
---

<BaseLayout title="AI clinical notes, done before you leave the room">
  <!-- The wash starts behind the sticky header, as in the design. -->
  <div class="bg-wash -mt-20 pt-20 lg:-mt-[7.6875rem] lg:pt-[7.6875rem]">
    <Hero />
  </div>
  <LogoStrip />
  <ProblemLine />
  <HowItWorks />
  <NoteContents />
  <AskTheChart />
  <OnTheRecord />
  <InControl />
  <Specialties />
  <Testimonials />
  <HomeFaq />
  <ContactSection />
</BaseLayout>
