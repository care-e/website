---
import SolutionLayout from '../layouts/SolutionLayout.astro';
import SectionTitle from '../components/solutions/SectionTitle.astro';
import SubTitle from '../components/solutions/SubTitle.astro';
import MediaSplit from '../components/solutions/MediaSplit.astro';
import IconCards from '../components/solutions/IconCards.astro';
import BulletList from '../components/solutions/BulletList.astro';
import { solutionIcon } from '../data/solution-nav';
import whatIs from '../assets/solutions/art/rpa-what-is.png';

// Copy from the previous care-e.ai RPA page.
const why = [
  {
    title: 'Fast Implementation',
    icon: solutionIcon('rapid-1.svg'),
    text: 'RPA can be deployed in weeks, providing immediate efficiency gains without the long timelines of traditional IT systems.',
  },
  {
    title: 'Scalable & Adaptive',
    icon: solutionIcon('scalability-1-1.svg'),
    text: 'Easily adjusts to evolving healthcare demands, seamlessly expanding as your organization grows.',
  },
  {
    title: 'Increased Efficiency',
    icon: solutionIcon('efficiency-2.svg'),
    text: 'Automates repetitive administrative tasks, reducing workload and freeing up staff to focus on patient care.',
  },
];

const tasks = [
  {
    lead: 'Logging into systems and applications',
    text: '– Automates credential entry and system access to save time.',
  },
  {
    lead: 'Managing files and organizing folders',
    text: '– Streamlines document storage and retrieval.',
  },
  {
    lead: 'Extracting, copying, and inputting data',
    text: '– Reduces manual entry errors and speeds up workflows.',
  },
  {
    lead: 'Filling out forms automatically',
    text: '– Ensures accuracy and consistency in documentation.',
  },
  {
    lead: 'Connecting to APIs and updating databases',
    text: '– Enables seamless data exchange across platforms.',
  },
  {
    lead: 'EHR Data Entry & Updates',
    text: '– Automates patient record updates to reduce documentation workload.',
  },
  {
    lead: 'Claims Processing & Billing',
    text: '– Automates claim suggestions and tracking to prevent denials.',
  },
  {
    lead: 'Patient Scheduling & Reminders',
    text: '– Manages appointments, confirmations, and follow-up reminders.',
  },
  {
    lead: 'Insurance Eligibility Verification',
    text: '– Validates patient insurance details in real time.',
  },
  {
    lead: 'Data Reconciliation & Reporting',
    text: '– Compiles and organizes data for financial, compliance, and operational reporting.',
  },
  {
    lead: 'Lab & Test Result Management',
    text: '– Extracts and updates lab results in EHRs for provider access.',
  },
];

const useCases = [
  {
    title: 'Patient Intake Management',
    icon: solutionIcon('bell-1.svg'),
    text: 'Automating the collection and entry of patient demographics, insurance information, and consent forms reduces wait times and ensures data accuracy.',
  },
  {
    title: 'Medical Billing Coding',
    icon: solutionIcon('sales-1-1.svg'),
    text: 'CARE-E streamlines the insurance claim submission process by recommending ICD-10 codes based on the patient encounter.',
  },
  {
    title: 'Appointment Scheduling',
    icon: solutionIcon('patient-3-1.svg'),
    text: 'Automating appointment reminders and rescheduling processes minimizes no-shows and optimizes clinical schedules.',
  },
  {
    title: 'Billing and Revenue Cycle Operations',
    icon: solutionIcon('regulatory-compliance-1-1.svg'),
    text: 'RPA ensures seamless data entry and reconciliation across billing systems, reducing errors and enhancing financial outcomes.',
  },
  {
    title: 'Regulatory Compliance Reporting',
    icon: solutionIcon('adaptation-1-1.svg'),
    text: 'Automating data aggregation and reporting processes ensures timely submissions and reduces the burden of audits.',
  },
  {
    title: 'Automated Marketing Campaigns',
    icon: solutionIcon('sales-process-1.svg'),
    text: 'Intelligently send communications to patients, such as scheduling visits and taking eligible health surveys.',
  },
];

const impact = [
  {
    title: 'Increased Efficiency',
    icon: solutionIcon('efficiency-1.svg'),
    text: 'Automating repetitive tasks frees clinicians to focus on patient care.',
  },
  {
    title: 'Higher Employee Satisfaction',
    icon: solutionIcon('improvement-1.svg'),
    text: 'Reducing tedious administrative work improves employee satisfaction and productivity.',
  },
  {
    title: 'Greater ROI',
    icon: solutionIcon('increase-1.svg'),
    text: 'Scalable, adaptable automation solutions provide value without disrupting existing systems.',
  },
];
---

<SolutionLayout
  title="Robotic Process Automation (RPA)"
  description="CARE-E uses robotic process automation to handle scheduling, claims, EHR data entry and other repetitive healthcare tasks—cutting errors and freeing staff for patient care."
>
  <section>
    <SectionTitle
      as="h1"
      lead="Transform Healthcare Operations with"
      highlight="Robotic Process Automation (RPA)"
    />
    <MediaSplit
      class="mt-10"
      image={whatIs}
      imageAlt="Robot assistant automating computer and billing tasks"
      imageWidth={422}
      reverse
    >
      <SubTitle>What is RPA?</SubTitle>
      <p class="mt-4 text-lead font-medium">
        Robotic Process Automation (RPA) is a technology that automates repetitive administrative
        and clinical tasks, reducing manual work for healthcare providers. It streamlines processes
        like patient scheduling, claims processing, and updating EHRs in real time. By minimizing
        manual data entry and improving accuracy, RPA helps healthcare teams work more efficiently,
        reducing errors and administrative burdens.
      </p>
    </MediaSplit>
    <SubTitle class="mt-12">How CARE-E Implements RPA</SubTitle>
    <p class="mt-4 text-lead font-medium">
      CARE-E leverages RPA to automate time-consuming tasks, allowing clinicians to focus more on
      patient care. It streamlines workflows by handling documentation, validating coding for
      compliance, and triggering alerts for incomplete or inconsistent information. By integrating
      seamlessly with EHRs and other healthcare systems, CARE-E reduces errors, accelerates
      processes, and improves overall efficiency—helping clinicians spend less time on paperwork and
      more time with patients.
    </p>
  </section>

  <section>
    <SubTitle>Why RPA for Healthcare?</SubTitle>
    <IconCards class="mt-8" variant="center" items={why} />
  </section>

  <section>
    <SubTitle>Automating Repetitive Tasks</SubTitle>
    <p class="mt-4 text-lead font-medium">
      CARE-E’s RPA capabilities streamline manual processes by capturing, interpreting, and managing
      data while seamlessly integrating with other systems. Tasks that CARE-E can automate include:
    </p>
    <BulletList class="mt-6" columns={2} items={tasks} />
    <p class="mt-6 text-lead font-medium">
      By automating these time-consuming tasks, CARE-E reduces administrative burden, minimizes
      errors, accelerates workflows, and improves overall efficiency in healthcare
      operations—allowing clinicians to focus more on patient care.
    </p>
  </section>

  <section>
    <SubTitle>Real-World Applications and Use Cases</SubTitle>
    <p class="mt-4 text-lead font-medium">
      CARE-E’s RPA solutions have transformed operations in diverse healthcare scenarios, including:
    </p>
    <IconCards class="mt-8" items={useCases} />
    <p class="mt-8 text-lead font-medium">
      By addressing these operational challenges, CARE-E’s RPA solutions empower healthcare
      organizations to focus on delivering high-quality patient care while ensuring administrative
      excellence.
    </p>
  </section>

  <section>
    <SubTitle>Measurable Impact with RPA</SubTitle>
    <p class="mt-4 text-lead font-medium">
      Integrating RPA into your healthcare operations with CARE-E delivers:
    </p>
    <IconCards class="mt-8" variant="center" items={impact} />
    <p class="mt-8 text-lead font-medium">
      Experience how CARE-E’s AI-driven RPA solutions can refine your healthcare operations. Let us
      help you implement intelligent automation for a more efficient and effective healthcare
      environment.
    </p>
  </section>
</SolutionLayout>
