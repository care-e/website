---
import SolutionLayout from '../layouts/SolutionLayout.astro';
import SectionTitle from '../components/solutions/SectionTitle.astro';
import SubTitle from '../components/solutions/SubTitle.astro';
import MediaSplit from '../components/solutions/MediaSplit.astro';
import IconCards from '../components/solutions/IconCards.astro';
import BulletList from '../components/solutions/BulletList.astro';
import { solutionIcon } from '../data/solution-nav';
import whatIs from '../assets/solutions/art/cdi-what-is.png';
import role from '../assets/solutions/art/cdi-role.png';
import caseStudy from '../assets/solutions/art/cdi-case-study.png';
import empowering from '../assets/solutions/art/cdi-empowering.png';
import auditIcon from '../assets/solutions/icons/audit.png';

// Copy from the previous care-e.ai CDI page.
const revolutionizes = [
  {
    title: 'Enhanced Accuracy and Completeness',
    icon: solutionIcon('accuracy-1.svg'),
    text: 'CARE-E identifies gaps in clinical documentation and suggests improvements to ensure comprehensive records that meet compliance and coding standards.',
  },
  {
    title: 'Real-Time Assistance',
    icon: solutionIcon('help-1.svg'),
    text: 'During patient encounters, CARE-E captures relevant details to document specific conditions, procedures, or comorbidities, reducing the need for retrospective corrections.',
  },
  {
    title: 'Coding Support',
    icon: solutionIcon('technical-support-1.svg'),
    text: 'CARE-E’s AI-driven algorithms automatically map clinical details to the correct ICD-10 codes, ensuring precise coding for accurate reimbursement and reducing administrative burden.',
  },
  {
    title: 'Audit Readiness',
    icon: auditIcon.src,
    text: 'By ensuring thorough documentation, CARE-E minimizes the risk of unfavorable audit outcomes and associated penalties, safeguarding healthcare organizations against compliance risks.',
  },
];

const benefits = [
  {
    title: 'Streamlined Workflows',
    icon: solutionIcon('customer-experience-1.svg'),
    text: 'CARE-E reduces administrative burdens by automating repetitive tasks, such as data entry and documentation review.',
  },
  {
    title: 'Improved Financial Performance',
    icon: solutionIcon('sales-1.svg'),
    text: 'Accurate documentation and coding ensure proper reimbursement, optimizing revenue cycles for both inpatient and outpatient settings.',
  },
  {
    title: 'Enhanced Patient Care',
    icon: solutionIcon('patient-3.svg'),
    text: 'Complete and clear documentation improves communication among care teams, leading to better continuity of care and patient outcomes.',
  },
  {
    title: 'Regulatory Compliance',
    icon: solutionIcon('regulatory-compliance-1.svg'),
    text: 'CARE-E aligns documentation practices with evolving payer requirements and federal regulations, reducing the risk of errors and compliance breaches.',
  },
  {
    title: 'Improved Patient Satisfaction',
    icon: solutionIcon('satisfaction-1.svg'),
    text: 'Clear, comprehensive documentation leads to better patient communication and transparency, ensuring patients feel informed and confident in their care.',
  },
  {
    title: 'Adaptability Across Settings',
    icon: solutionIcon('adaptation-1.svg'),
    text: 'From hospitals to outpatient clinics, CARE-E adapts to diverse healthcare environments, providing tailored CDI support to meet specific organizational and specialty needs.',
  },
];
---

<SolutionLayout
  title="Clinical Documentation Improvement (CDI)"
  description="CARE-E improves clinical documentation with real-time capture, gap detection, ICD-10 coding support and audit readiness—so clinicians spend less time on paperwork."
>
  <section class="space-y-12 lg:space-y-[3.75rem]">
    <SectionTitle as="h1" lead="Elevating Clinical Documentation with" highlight="CARE-E" />
    <MediaSplit
      image={whatIs}
      imageAlt="Clinician reviewing a digital medical chart"
      imageWidth={375}
    >
      <SubTitle>What Is Clinical Documentation?</SubTitle>
      <p class="mt-4 text-lead font-medium">
        Clinical documentation is the foundation of patient care, capturing key details including
        diagnoses, treatment plans, and progress notes in the medical record. Accurate documentation
        ensures clear communication among care teams, supports proper coding and billing, and helps
        maintain compliance with healthcare regulations.
      </p>
    </MediaSplit>
    <MediaSplit
      image={role}
      imageAlt="Doctor presenting an electronic medical record"
      imageWidth={480}
      reverse
    >
      <SubTitle>The Role of Clinical Documentation Improvement (CDI)</SubTitle>
      <div class="mt-4 space-y-4 text-lead font-medium">
        <p>
          Accurate and complete documentation is essential for delivering quality patient care,
          ensuring proper coding, and meeting compliance standards. Clinical Documentation
          Improvement (CDI) helps streamline this process by identifying missing details, improving
          accuracy, and reducing the time spent on paperwork.
        </p>
        <p>
          By enhancing documentation, CDI supports better communication among care teams, reduces
          administrative burden, and ensures that records reflect the full scope of patient care. As
          healthcare evolves, CDI plays a critical role in improving efficiency, reducing errors,
          and optimizing reimbursement—allowing clinicians to focus more on their patients and less
          on paperwork.
        </p>
      </div>
    </MediaSplit>
  </section>

  <section>
    <SectionTitle lead="Challenges in" highlight="Clinical Documentation" />
    <SubTitle class="mt-6">
      Healthcare providers face significant documentation challenges, including:
    </SubTitle>
    <BulletList
      class="mt-6"
      items={[
        {
          lead: 'Heavy administrative workload',
          text: '– that takes time away from patient care.',
        },
        {
          lead: 'Complex compliance and regulatory requirements',
          text: '– that demand precision.',
        },
        { lead: 'Accurate coding demands', text: '– to ensure proper reimbursement.' },
      ]}
    />
    <p class="mt-6 text-lead font-medium">
      Even with EHRs streamlining some processes, clinicians often feel overwhelmed by documentation
      tasks, adding to burnout and reducing time for direct patient interaction.
    </p>
  </section>

  <section>
    <SectionTitle lead="How CARE-E" highlight="Revolutionizes Clinical Documentation" />
    <IconCards class="mt-10 lg:mt-[3.125rem]" items={revolutionizes} />
  </section>

  <section>
    <SectionTitle lead="Key Benefits of CARE-E in" highlight="CDI Programs" />
    <IconCards class="mt-10 lg:mt-[3.125rem]" items={benefits} />
  </section>

  <section>
    <MediaSplit
      image={caseStudy}
      imageAlt="Physician reviewing an insurance form on a tablet"
      imageWidth={400}
      reverse
    >
      <SectionTitle lead="Real-World Impact:" highlight="A Case Study" />
      <p class="mt-6 text-lead font-medium">
        A patient visits their primary care physician for persistent fatigue and shortness of
        breath. During the encounter, the physician documents the symptoms and conducts a thorough
        review, uncovering uncontrolled hypertension (ICD-10: I10) and suspected Type 2 diabetes
        mellitus (ICD-10: E11.9) based on recent lab results. Using AI-driven Clinical Documentation
        Improvement (CDI) tools, the system prompts the physician to include detailed notes,
        suggests relevant ICD-10 codes, and links conditions to appropriate orders, such as a
        hemoglobin A1c test and a cardiology referral. The AI ensures accurate documentation of the
        primary complaint (fatigue, ICD-10: R53.83), identifies comorbidities, and streamlines the
        generation of a comprehensive encounter summary, treatment plan, and patient orders. This
        process enhances coding accuracy for billing, supports quality reporting, and improves
        continuity of care by addressing the patient’s full spectrum of health needs.
      </p>
    </MediaSplit>
  </section>

  <section>
    <SectionTitle lead="Empowering Providers and" highlight="CDI Specialists" />
    <MediaSplit
      class="mt-6"
      image={empowering}
      imageAlt="Two specialists connecting documentation and coding data"
      imageWidth={560}
    >
      <p class="text-lead font-medium">
        CARE-E enhances clinical documentation by equipping clinical care teams with the latest
        documentation technologies for greater accuracy and efficiency. CARE-E helps:
      </p>
      <BulletList
        class="mt-4"
        items={[
          'Bridge the gap between clinical care and accurate coding.',
          'Reduce claim denials and the need for resubmissions.',
          'Support documentation and coding for quality initiatives, including MACRA/MIPS and other quality measures and Social Determinants of Health (SDOH) reporting.',
        ]}
      />
      <p class="mt-4 text-lead font-medium">
        With a comprehensive suite of capabilities, CARE-E enables providers to focus more on
        patient care while ensuring documentation meets regulatory and quality standards.
      </p>
    </MediaSplit>
  </section>
</SolutionLayout>
