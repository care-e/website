---
import SolutionLayout from '../layouts/SolutionLayout.astro';
import SectionTitle from '../components/solutions/SectionTitle.astro';
import SubTitle from '../components/solutions/SubTitle.astro';
import MediaSplit from '../components/solutions/MediaSplit.astro';
import IconCards from '../components/solutions/IconCards.astro';
import { solutionIcon } from '../data/solution-nav';
import channels from '../assets/solutions/art/pe-channels.png';

// Copy from the previous care-e.ai Patient Engagement page.
const interactions = [
  {
    title: 'Scheduling',
    icon: solutionIcon('schedule-1.svg'),
    text: 'Automate appointment reminders, confirmations, and rescheduling processes, reducing no-shows and optimizing clinic schedules.',
  },
  {
    title: 'Assessments',
    icon: solutionIcon('list-1.svg'),
    text: 'Deliver pre-visit questionnaires and post-care surveys tailored to each patient’s needs, ensuring better insights and outcomes.',
  },
  {
    title: 'Enrollments',
    icon: solutionIcon('enrollment-1.svg'),
    text: 'Simplify the onboarding process for care programs, ensuring patients receive the resources they need with minimal administrative effort.',
  },
];

const adherence = [
  {
    title: 'Personalization',
    icon: solutionIcon('personalized-1.svg'),
    text: 'Tailoring communications and reminders based on patient preferences and medical history.',
  },
  {
    title: 'Real-Time Insights',
    icon: solutionIcon('real-time-monitoring-1.svg'),
    text: 'Empowering providers with data-driven recommendations to address patient needs effectively.',
  },
  {
    title: 'Consistent Follow-Up',
    icon: solutionIcon('consistency-1.svg'),
    text: 'Ensuring patients stay connected with their care team through timely updates and check-ins.',
  },
];
---

<SolutionLayout
  title="Patient Engagement"
  description="CARE-E engages patients across text, email, phone and portals—automating scheduling, assessments and enrollments to improve adherence and satisfaction."
>
  <section>
    <SectionTitle as="h1" lead="Enhance Patient Engagement with" highlight="CARE-E" />
    <MediaSplit
      class="mt-8"
      image={channels}
      imageAlt="Patients connected through phones across communication channels"
      imageWidth={451}
    >
      <SubTitle>Seamless Communication Across Channels</SubTitle>
      <p class="mt-4 text-lead font-medium">
        Modern healthcare demands communication strategies that meet patients where they are, on
        their terms. CARE-E’s omni-channel communication approach ensures that every touchpoint is
        optimized for patient convenience and accessibility. Whether it’s through text messages,
        emails, phone calls, or patient portals, CARE-E delivers information and updates in the
        formats patients prefer, improving satisfaction and engagement.
      </p>
    </MediaSplit>
  </section>

  <section>
    <SubTitle>Automating Patient Interactions</SubTitle>
    <p class="mt-4 text-lead font-medium">
      CARE-E leverages intelligent automation to simplify and enhance critical patient activities,
      including:
    </p>
    <IconCards class="mt-8" variant="center" items={interactions} />
    <p class="mt-8 text-lead font-medium">
      By automating these processes, CARE-E ensures accuracy, reduces staff workload, and creates a
      seamless experience for patients.
    </p>
  </section>

  <section>
    <SubTitle>Maximizing Patient Adherence and Participation</SubTitle>
    <p class="mt-4 text-lead font-medium">
      Patient engagement goes beyond communication—it’s about fostering adherence to care plans and
      encouraging active participation. CARE-E achieves this through:
    </p>
    <IconCards class="mt-8" variant="center" items={adherence} />
    <p class="mt-8 text-lead font-medium">
      This holistic approach improves health outcomes while enhancing the patient’s role in their
      own care journey.
    </p>
  </section>
</SolutionLayout>
