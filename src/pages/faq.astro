---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionTitle from '../components/solutions/SectionTitle.astro';
import Button from '../components/Button.astro';
import { ROUTES } from '../consts';

const CATEGORIES = [
  'Company',
  'Support and Implementation',
  'Technology, Integrations and Security',
  'Industry Terms',
  'General',
] as const;

const entries = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
const items = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content })),
);
const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');

// FAQPage structured data with plain-text answers.
const toText = (md: string) =>
  md
    .replace(/!\[[^\]]*\]\([^)]*\)/g, '')
    .replace(/\[([^\]]+)\]\([^)]*\)/g, '$1')
    .replace(/\*\*/g, '')
    .replace(/^\s*-\s+/gm, '• ')
    .trim();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: entries.map((e) => ({
    '@type': 'Question',
    name: e.data.question,
    acceptedAnswer: { '@type': 'Answer', text: toText(e.body ?? '') },
  })),
};
---

<BaseLayout
  title="FAQ"
  description="Answers to common questions about CARE-E Ai: implementation, support, EHR integrations, security, pricing and industry terms like CDI, CDS and RPA."
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
  <div class="bg-wash -mt-20 pt-20 pb-20 lg:-mt-[7.6875rem] lg:pt-[7.6875rem] lg:pb-[9.375rem]">
    <div class="container-page pt-10 lg:pt-[6.25rem]">
      <SectionTitle as="h1" lead="Frequently Asked" highlight="Questions" />
      <p class="mt-4 text-title leading-[1.236] font-bold text-brand">Have any questions?</p>

      <nav aria-label="FAQ categories" class="mt-8 lg:mt-[3.125rem]">
        <ul class="flex flex-wrap gap-2.5">
          {CATEGORIES.map((c) => (
            <li>
              <a
                href={`#${slug(c)}`}
                class="border-brand-gradient block rounded-[0.625rem] px-5 py-3 text-[clamp(0.875rem,0.8rem+0.2vw,1.25rem)] font-semibold text-brand hover:bg-brand-tint"
              >
                {c}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mt-12 space-y-14 lg:mt-[4.6875rem] lg:space-y-[4.6875rem]">
        {CATEGORIES.map((category) => (
          <section id={slug(category)} class="scroll-mt-28 lg:scroll-mt-40">
            <h2 class="text-display font-semibold">{category}</h2>
            <div class="mt-6 space-y-4">
              {items
                .filter(({ entry }) => entry.data.category === category)
                .map(({ entry, Content }) => (
                  <details class="group border-brand-gradient rounded-[0.625rem] open:shadow-md">
                    <summary class="flex cursor-pointer list-none items-center justify-between gap-6 px-6 py-5 text-[1.5625rem] leading-[1.3] font-semibold text-brand marker:hidden lg:px-[1.875rem] [&::-webkit-details-marker]:hidden">
                      <h3>{entry.data.question}</h3>
                      <span
                        class="flex size-9 shrink-0 items-center justify-center rounded-full bg-brand-tint text-2xl leading-none transition-transform group-open:rotate-45"
                        aria-hidden="true"
                      >
                        +
                      </span>
                    </summary>
                    <div class="prose-content px-6 pb-6 lg:px-[1.875rem] lg:pb-[1.875rem]">
                      <Content />
                    </div>
                  </details>
                ))}
            </div>
          </section>
        ))}
      </div>

      <div class="mt-16 flex flex-col items-center gap-6 text-center lg:mt-[6.25rem]">
        <p class="text-title leading-[1.236] font-bold">Still have questions?</p>
        <Button href={ROUTES.contact} class="h-[3.75rem]">
          Contact Us
        </Button>
      </div>
    </div>
  </div>
</BaseLayout>
